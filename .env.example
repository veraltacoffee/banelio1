# ====================================================================
# BANELIO.COM - PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================

# GEMINI_API_KEY: Required for AI smart domain suggestions & assistance
GEMINI_API_KEY=""

# APP_URL: Canonical application URL (e.g., https://banelio.com)
APP_URL="https://banelio.com"

# ====================================================================
# DATABASE (FASE 1 - Prisma + SQLite)
# ====================================================================
# Prisma Migrate resolves "file:./dev.db" relative to the schema directory
# (prisma/), creating prisma/dev.db. The server (server/db.ts) anchors that
# same file for runtime, so both always share one database. To scale later,
# swap to PostgreSQL e.g. DATABASE_URL="postgresql://user:pass@host/db".
DATABASE_URL="file:./dev.db"

# Explicit environment for payment/behavior gating: 'dev' | 'sandbox' | 'production'
# Used to disable dev-only features (e.g. simulated OXXO payment) in production.
PAYMENTS_ENV="dev"

# ====================================================================
# RESELLERCLUB / ORDERBOX API INTEGRATION (SERVER-SIDE SECRETS)
# ====================================================================
# Note: Never expose these variables to the frontend (no VITE_ prefix).
# All requests to ResellerClub must proxy through server-side endpoints.

# Your ResellerClub Reseller ID (Found in ResellerClub Control Panel -> Settings -> API)
RESELLERCLUB_RESELLER_ID=""

# Your ResellerClub API Key (32-character hex key generated in ResellerClub panel)
RESELLERCLUB_API_KEY=""

# API Environment: 'test' for Sandbox/Test environment or 'prod' for Production
RESELLERCLUB_ENVIRONMENT="test"

# Base API URLs:
# Test: https://test.httpapi.com/api/
# Production: https://httpapi.com/api/
RESELLERCLUB_API_BASE_URL="https://test.httpapi.com/api/"

# Server Public Outbound IPv4 for ResellerClub Whitelist (Must be registered in ResellerClub panel)
RESELLERCLUB_IP_WHITELIST=""

# ====================================================================
# PAYMENT GATEWAYS (STRIPE, PAYPAL, OXXO PAY)
# ====================================================================
# STRIPE: Credit/Debit cards & OXXO Pay via Stripe Sources
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# PAYPAL: PayPal Express Checkout & Subscriptions
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox" # 'sandbox' for testing or 'live' for production

# FX USD->MXN para OXXO Pay (cálculo REAL en el servidor; nunca se inventa).
# Por defecto se usa la API pública open.er-api.com con caché (sin key).
# Opcional: fijar manualmente la tasa para entornos sin salida a Internet.
FX_API_BASE_URL="https://open.er-api.com/v6/latest/USD"
FX_USD_MXN_RATE=""

# ====================================================================
# NOTIFICATIONS & EMAIL TRANSACTIONS
# ====================================================================
SUPPORT_EMAIL="try@banelio.com"
NOTIFICATIONS_FROM="Banelio <try@banelio.com>"

