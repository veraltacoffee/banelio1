# ==========================================
# BANELIO - Variables de Entorno de Ejemplo
# ==========================================

# Base de datos (SQLite en dev, PostgreSQL en prod)
DATABASE_URL=file:./dev.db

# Tipo de Cambio y FX
FX_API_BASE_URL=https://open.er-api.com/v6/latest/USD
FX_USD_MXN_RATE=

# Notificaciones y Soporte
NOTIFICATIONS_FROM=
SUPPORT_EMAIL=try@banelio.com

# Pasarela de Pagos - Stripe y OXXO
PAYMENTS_ENV=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Pasarela de Pagos - PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ==========================================
# Proveedor Externo: ResellerClub
# ==========================================
# Entorno: 'sandbox' (pruebas) o 'live' (producción)
RESELLERCLUB_ENVIRONMENT=sandbox

# CANAL 1: API REST MODERNA (Dominios, Clientes, Contactos, DNS)
# Feature flag para activar disponibilidad nativa via ResellerClub ('true' | 'false', por defecto 'false')
RESELLERCLUB_ENABLE_DOMAINS_NATIVE=false
# Base URL REST: https://test-api.resellerclub.com/v1/ (sandbox) o https://api.resellerclub.com/v1/ (live)
RESELLERCLUB_REST_BASE_URL=
# Credenciales REST (Autenticación via cabeceras X-User-Id y Authorization: ApiKey <KEY>):
RESELLERCLUB_REST_USER_ID=
RESELLERCLUB_REST_API_KEY=

# CANAL 2: HTTP API HEREDADA (Hosting, Email, SSL, Costos, Órdenes)
# Base URL Legacy: https://test.httpapi.com/api/ (sandbox) o https://httpapi.com/api/ (live)
RESELLERCLUB_LEGACY_BASE_URL=
# Credenciales Legacy (Autenticación via auth-userid y api-key en query/form):
RESELLERCLUB_LEGACY_RESELLER_ID=
RESELLERCLUB_LEGACY_API_KEY=

# Ubicación geográfica del centro de datos para Hosting Linux (ej. 'us', 'in', 'uk', 'hk')
# Requerida oficialmente para construir la ruta: singledomainhosting/linux/{location}/add.json
RESELLERCLUB_HOSTING_LOCATION=

# NOTA DE REUTILIZACIÓN:
# Si tu cuenta mayorista utiliza la misma credencial para ambos canales,
# puedes definir alternativamente las variables unificadas de fallback:
RESELLERCLUB_RESELLER_ID=
RESELLERCLUB_API_KEY=

# Seguridad de red: IP pública autorizada en la consola de ResellerClub
RESELLERCLUB_IP_WHITELIST=
