# ==============================================================================
# BANELIO — Configuración Apache para Hosting Compartido IONOS
# ==============================================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. Redirecciones 301 de Aliases hacia Rutas Canónicas Oficiales
  # ----------------------------------------------------------------------------
  RewriteRule ^domains/?$ /dominios [R=301,L,NC]
  RewriteRule ^correo/?$ /email [R=301,L,NC]
  RewriteRule ^seguridad/?$ /ssl [R=301,L,NC]
  RewriteRule ^diseno/?$ /diseno-web [R=301,L,NC]
  RewriteRule ^web/?$ /diseno-web [R=301,L,NC]
  RewriteRule ^affiliates/?$ /afiliados [R=301,L,NC]
  RewriteRule ^revendedores/?$ /resellers [R=301,L,NC]

  # ----------------------------------------------------------------------------
  # 2. Servir archivos y directorios físicos existentes sin alterar
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------------
  # 3. Fallback de Enrutamiento para SPA
  # ----------------------------------------------------------------------------
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. Compresión GZIP / Deflate para recursos de texto
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 5. Políticas de Caché de Recursos Estáticos
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 6. Cabeceras de Seguridad y Protección de Cabeceras
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
