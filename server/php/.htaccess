# ==============================================================================
# BANELIO - Configuración de Seguridad Apache para Hosting Compartido IONOS
# Ubicación de despliegue: /api/.htaccess
# ==============================================================================

# 1. Prohibir el listado de directorios
Options -Indexes

# 2. Desactivar firmas de versión del servidor web
ServerSignature Off

# 3. Bloqueo estricto de acceso HTTP directo a archivos de configuración,
#    variables de entorno, credenciales locales, respaldos y repositorios.
<FilesMatch "(^\.|\.env|\.local\.php$|\.json$|\.lock$|\.md$|\.log$|\.sql$|\.bak$|\.inc$|\.ini$|\.ya?ml$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Bloqueo de acceso HTTP directo a archivos de inclusión y librerías internas
#    que nunca deben ser invocados directamente desde un navegador o cliente HTTP.
<FilesMatch "^(config\.php|client\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Cabeceras HTTP de protección y prevención de caché en respuestas de API
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</IfModule>
