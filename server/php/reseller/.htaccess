# ==============================================================================
# BANELIO - Protección de Directorio Reseller en IONOS
# Ubicación de despliegue: /api/reseller/.htaccess
# ==============================================================================

Options -Indexes
ServerSignature Off

# Bloquear bibliotecas y archivos de configuración sensibles
<FilesMatch "(^\.|\.local\.php$|config\.php$|client\.php$|\.json$|\.log$|\.env|\.md$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Permitir explícitamente solo test-connection.php para diagnósticos controlados
<Files "test-connection.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>
