<?php
/**
 * BANELIO - Plantilla de Configuración Local Segura para IONOS
 * Archivo: server/php/reseller/config.local.php.example
 *
 * Instrucciones:
 * 1. Copia este archivo como 'config.local.php' en tu hosting IONOS dentro de /api/reseller/
 *    o preferentemente un nivel superior fuera de la raíz web pública (document root).
 * 2. Reemplaza los valores con tus credenciales reales de ResellerClub y tu clave secreta HMAC.
 * 3. NUNCA subas 'config.local.php' al repositorio de GitHub (está en .gitignore).
 */

// Bloqueo estricto de acceso HTTP directo
if (!defined('BANELIO_BRIDGE_LOADED') && basename($_SERVER['SCRIPT_FILENAME'] ?? '') === basename(__FILE__)) {
    http_response_code(403);
    header('Content-Type: application/json; charset=utf-8');
    echo json_encode(['success' => false, 'error' => 'Acceso directo denegado.'], JSON_UNESCAPED_UNICODE);
    exit;
}

// Credenciales oficiales de ResellerClub
define('RESELLERCLUB_RESELLER_ID', '1014164');
define('RESELLERCLUB_API_KEY', 'TU_RESELLERCLUB_API_KEY_AQUI');
define('PHP_BRIDGE_SECRET', 'TU_CLAVE_SECRETA_HMAC_COMPARTIDA_AQUI');
define('RESELLERCLUB_ENVIRONMENT', 'sandbox'); // Cambiar a 'live' cuando esté verificado en producción
